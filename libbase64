async function
  _output_files_get(
    _input_file,
    _output_prefix) {
  let
    _file,
    _mv_args,
    _output_file,
    _output_files,
    _part_no;
  _output_files =
    [];
  const
    _file_name =
      _basename(
        _input_file);
  const
    _pattern =
      `${_file_name}.sf-part`
  const
    _dir =
      _dirname(
        _input_file);
  const
    _dir_content =
      _ls(
        _dir);
  for ( _file of _dir_content ) {
    if ( _file.startsWith(
           _pattern)) {
      _part_no =
        _file.replace(
          _pattern,
          "");
      _output_file =
        `${_output_prefix}${_part_no}`;
      _mv_args = [
        `${_input_file}.sf-part${_part_no}`,
        _output_file
      ];
      _mv.apply(
        null,
        _mv_args);
      _output_files.push(
        _output_file);
    }
  }
  return _output_files;
}

function
  _target_command_check(
    _target_command,
    _encode_data,
    _decode_data) {
  let
    _msg,
    _target_command_get;
  _target_command_get =
    false;
  const
    _default =
      "encode";
  const
    _target_command_type =
      typeof(
        _target_command);
  if ( _target_command_type === "undefined" ) {
    _msg =
      "Target command is undefined, setting " +
      `default '${_default}'.`;
    _msg_info(
      _msg);
    _target_command_get =
      true;
  }
  else if ( _target_command_type === "string" ) {
    if ( _target_command.length < 1 ) {
      _msg =
        "Target command is an empty string, setting " +
        `default '${_encode}'.`;
      _msg_info(
        _msg);
      _target_command_get =
        true;
    }
  }
  else if ( _target_command_type === "object" ) {
    _target_command_keys =
      Object.keys(
        _target_command);
    if ( _target_command_keys.length < 1 ) {
      _msg =
        "Target command is an empty object, setting " +
        `default '${_encode}'.`;
      _msg_info(
        _msg);
      _target_command_get =
        true;
    }
    else {
      _msg =
        "Variable 'target command' must be a string " +
        "and can have values 'encode' or 'decode'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      `Unknown type '${_target_command_type}' ` +
      "for variable 'target command'. Allowed " +
      "type is 'string' with values 'encode' or 'decode'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _target_command_get ) {
    if ( _encode_data === "y" &&
         _decode_data === "n" ) {
      _target_command =
        "encode";
    }
    else if ( _encode_data === "n" &&
              _decode_data === "y" ) {
      _target_command =
        "decode";
    }
    else {
      _target_command =
        _default;
    }
  }
  return _target_command;
}

function
  _output_file_check(
    _output_file) {
  let
    _stdout_print;
  const
    _output_file_type =
      typeof(
        _output_file);
  if ( _output_file_type === "undefined" ) {
    _stdout_print =
      true;
  }
  else if ( _output_file_type === "string" ) {
    if ( _output_file.length < 1 ) {
      _stdout_print =
        true;
    }
    else {
      const
        _output_dir =
          _dirname(
            _output_file);
      const
        _output_dir_exists =
          _dir_exists(
            _output_dir);
      if ( ! _output_dir_exists ) {
        _msg =
          `Directory '${_output_dir} ` +
          "does not exist.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
      else {
        _stdout_print =
          false;
      }
    }
  }
  else if ( _output_file_type === "object" ) {
    const
      _output_file_keys =
        Object.keys(
          _output_file);
    if ( _output_file_keys.length < 1 ) {
      _stdout_print =
        true;
    }
    else {
      _msg =
        "Variable 'output file' should be " +
        "a string, not an object.";
      _msg_error(
        _msg,
        0);
      _echo2(
        _output_file);
      throw _msg;
    }
  }
  else {
    _msg =
      "Variable 'output file' should be " +
      `a string, not an '${_output_file_type}'.`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _output_file);
    throw _msg;
  }
  const
    _output = [
      _output_file,
      _stdout_print
    ];
  return _output;
}

async function
  _base64(
    _encode_data,
    _decode_data,
    _input_files,
    _output_file,
    _size_max) {
  let
    _bin2txt_args,
    _content,
    _chunks_total,
    _decoded_files,
    _encoded_files,
    _file_append_args,
    _out_file_txt2bin,
    _output_files,
    _file,
    _msg,
    _target_command,
    _tmp_dir,
    _stdout_print;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  _output_files =
    [];
  try {
    _target_command =
      _target_command_check(
        _target_command,
        _encode_data,
        _decode_data);
  }
  catch(
    _error) {
    _msg =
      "Error running '_target_command_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _out_prefix =
      _path_join([
        _pwd(),
        "tmp."
      ]);
  const
    _mktemp_args = [
      _out_prefix,
      true          // output target is a directory
    ];
  try {
    _tmp_dir =
      await _mktemp.apply(
        null,
        _mktemp_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_mktemp' " +
      "arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _mktemp_args);
    _echo2(
      _error);
    throw _error;
  }
  if ( _target_command === "encode" ) {
    _msg =
      `Encoding file '${_file}' ` +
      `in base64.`;
    _msg_info(
      _msg);
    const
      _out_prefix_bin2txt =
        _path_join([
          _tmp_dir,
          "tmp."
        ]);
    for ( _file of _input_files) {
      _bin2txt_args = [
        _file,
        _out_prefix_bin2txt,
        "base64",             // format
        100000,               // length
        20000000,             // buffer_size_bytes
        "n",                  // amount only
        "memory"              // encoding type
      ];
      _msg =
        "Running '_bin2txt' " +
        "with arguments:";
      _msg_info(
        _msg);
      if ( _quiet === "n" ) {
        _echo(
          _bin2txt_args);
      }
      try {
        [ _chunks_total,
          _encoded_files ] =
          await _bin2txt.apply(
            null,
            _bin2txt_args);
        _output_files =
          _output_files.concat(
            _encoded_files);
      }
      catch(
        _error) {
        _msg =
          "Error running '_bin2txt' with " +
          "arguments:";
        _msg_error(
          _msg,
          0);
        _echo2(
          _bin2txt_args);
        _echo2(
          _error);
        throw _error;
      }
    }
  }
  else if ( _target_command === "decode" ) {
    _out_file_txt2bin =
      _path_join([
        _tmp_dir,
        "tmp."
      ]);
    const
      _txt2bin_args = [
        _out_file_txt2bin,
        "base64",            // encoding format
        "file",              // argument type
        "",                  // encoding type (unused)
        _input_files,
        true                 // input files sanity check
      ];
    try {
      _out_file_txt2bin =
        await _txt2bin.apply(
          null,
          _txt2bin_args);
      _output_files.push(
        _out_file_txt2bin);
    }
    catch(
      _error) {
      _msg =
        "Error running '_txt2bin' with " +
        "arguments:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _txt2bin_args);
      _echo2(
        _error);
      throw _error;
    }
  }
  else {
    _msg =
      "Unknown command " +
      `'${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  const
    _output_file_check_args = [
      _output_file
    ];
  try {
    [ _output_file,
      _stdout_print ] =
      _output_file_check.apply(
        null,
        _output_file_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_output_file_check' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _output_file_check_args);
    _echo2(
      _error);
    throw _error;
  }
  if ( _stdout_print ) {
    for ( _file of _output_files ) {
      _content =
        _cat(
          _file);
      _printf(
        _content);
      _rm(
        _file);
    }
    _rmdir(
      _tmp_dir);
  }
  else {
    if ( _target_command === "encode" ) {
      for ( _file of _output_files ) {
        _content =
          _cat(
            _file);
        _file_append_args = [
          _output_file,
          _content
        ];
        _file_append.apply(
          null,
          _file_append_args);
        _rm(
          _file);
        _rmdir(
          _tmp_dir);
      }
    }
    else if ( _target_command === "decode" ) {
      _cp(
        _out_file_txt2bin,
        _output_file);
      _rm(
        _out_file_txt2bin);
      _rmdir(
        _tmp_dir);
    }

  }
  return _output_files;
}

