async function
  _output_files_get(
    _input_file,
    _output_prefix) {
  let
    _file,
    _mv_args,
    _output_file,
    _output_files,
    _part_no;
  _output_files =
    [];
  const
    _file_name =
      _basename(
        _input_file);
  const
    _pattern =
      `${_file_name}.sf-part`
  const
    _dir =
      _dirname(
        _input_file);
  const
    _dir_content =
      _ls(
        _dir);
  for ( _file of _dir_content ) {
    if ( _file.startsWith(
           _pattern)) {
      _part_no =
        _file.replace(
          _pattern,
          "");
      _output_file =
        `${_output_prefix}${_part_no}`;
      _mv_args = [
        `${_input_file}.sf-part${_part_no}`,
        _output_file
      ];
      _mv.apply(
        null,
        _mv_args);
      _output_files.push(
        _output_file);
    }
  }
  return _output_files;
}

function
  _target_command_check(
    _target_command,
    _encode_data,
    _decode_data) {
  let
    _msg,
    _target_command_get;
  _target_command_get =
    false;
  const
    _default =
      "encode";
  const
    _target_command_type =
      typeof(
        _target_command);
  if ( _target_command_type === "undefined" ) {
    _msg =
      "Target command is undefined, setting " +
      `default '${_encode}'.`;
    _msg_info(
      _msg);
    _target_command_get =
      true;
  }
  else if ( _target_command_type === "string" ) {
    if ( _target_command.length < 1 ) {
      _msg =
        "Target command is an empty string, setting " +
        `default '${_encode}'.`;
      _msg_info(
        _msg);
      _target_command_get =
        true;
    }
  }
  else if ( _target_command_type === "object" ) {
    _target_command_keys =
      Object.keys(
        _target_command);
    if ( _target_command_keys.length < 1 ) {
      _msg =
        "Target command is an empty object, setting " +
        `default '${_encode}'.`;
      _msg_info(
        _msg);
      _target_command_get =
        true;
    }
    else {
      _msg =
        "Variable 'target command' must be a string " +
        "and can have values 'encode' or 'decode'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      `Unknown type '${_target_command_type}' ` +
      "for variable 'target command'. Allowed " +
      "type is 'string' with values 'encode' or 'decode'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _target_command_get ) {
    if ( _encode_data === "y" &&
         _decode_data === "n" ) {
      _target_command =
        "encode";
    }
    else if ( _encode_data === "n" &&
              _decode_data === "y" ) {
      _target_command =
        "decode";
    }
    else {
      _target_command =
        _default;
    }
  }
  return _target_command;
}

async function
  _base64(
    _encode_data,
    _decode_data,
    _input_files,
    _size_max) {
  let
    _content,
    _encoded_files,
    _file,
    _msg,
    _target_command;
  try {
    _target_command =
      _target_command_check(
        _target_command,
        _encode_data,
        _decode_data);
  }
  catch(
    _error) {
    _msg =
      "Error running '_target_command_check'.";
    _msg_error(
      _msg,
      0);
    _echo(
      _error);
    throw _error;
  }
  if ( _target_command === "encode" ) {
    _msg =
      `Encoding file '${_file}' ` +
      `in base64.`;
    _msg_info(
      _msg);
    _out =
      _path_join([
        _pwd(),
        "tmp."
      ]);
    const
      _bin2txt_args = [
        _file,
        _out,
        "base64",             // format
        200000,               // length
        20000000,             // buffer_size_bytes
        "n",                  // amount only
        "memory"              // encoding type
      ];
    try {
      _encoded_files =
        await _bin2txt.apply(
          null,
          _bin2txt_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_bin2txt' with " +
        "arguments:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _bin2txt_args);
      _echo2(
        _error);
      throw _error;
    }
  }
  for ( _file of _encoded_files ) {
    _content =
      _cat(
        _file);
    _printf(
      _content);
  }
  return _output_files;
}

