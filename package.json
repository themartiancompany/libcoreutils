{
  "name":
    "libcoreutils",
  "version":
    "0.0.25",
  "description":
    "Javascript implementations of some GNU coreutils.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man":
    "./man/base64.js.1",
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "base64",
    "base64.webpack.config.cjs",
    "dist",
    "eslint.config.mjs",
    "package.json",
    "fs-worker.webpack.config.cjs",
    "serve.json",
    "libbase64",
    "libbase64.webpack.config.cjs",
    "libcoreutils",
    "webpack.config.cjs"
  ],
  "keywords": [
    "base64",
    "coreutils",
    "gnu",
    "senzacoreutils",
    "ur",
    "themartiancompany",
    "dogeos"
  ],
  "homepage":
    "https://github.com/themartiancompany/libcoreutils",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/libcoreutils/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/tmcbase64.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "compression":
      "^1.8.2",
    "crash-js-webpack":
      "^0.0.84",
    "eslint":
      "^10.14.0",
    "globals":
      "^17.3.0",
    "@eslint/config-array":
      "^0.23.5",
    "@eslint/js":
      "^10.0.1",
    "@eslint/object-schema":
      "^3.0.5",
    "minimatch":
      "^11.0.4",
    "safely-serve":
      "^0.0.25",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^1000000000000020.1000000000000001.1000000000000001",
    "minimatch":
      "^11.0.4",
    "encoding-tools":
      "^0.0.24"
  },
  "overrides": {
    "compression":
      "^1.8.2",
    "eslint":
      "^10.14.0",
    "@eslint/config-array":
      "^0.23.5",
    "@eslint/object-schema":
      "^3.0.5",
    "minimatch":
      "^11.0.4",
    "base64":
      "./libbase64"
  },
  "type":
    "module",
  "main":
    "libcoreutils",
  "bin":
    {
      "base64":
        "./base64",
      "base64.js":
        "./base64",
      "tmcbase64":
        "./base64" },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details; cp 'fs-worker.js' 'dist/libbase64'; cp 'fs-worker.js' 'dist/base64'; cp 'fs-worker.js' 'dist/libcoreutils'",
    "build-libbase64":
      "npx webpack --mode 'production' --config 'libbase64.webpack.config.cjs' --stats-error-details && cp 'libbase64.js' 'dist/libbase64'",
    "build-lib":
      "npm run build-libbase64; npm run build-libcoreutils",
    "build-base64":
      "npx webpack --mode 'production' --config 'base64.webpack.config.cjs' --stats-error-details && cp 'base64.js' 'dist/base64'",
    "build-libcoreutils":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && cp 'libcoreutils.js' 'dist/libcoreutils'",
    "build-bin":
      "npm run build-base64",
    "build":
      "npm run build-fs-worker && npm run build-lib && npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm lint && npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/libcoreutils'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
