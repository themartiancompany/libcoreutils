/* eslint
     no-unused-vars: [
       "error",
       { "vars":
           "local",
         "argsIgnorePattern":
           "output_prefix" } ] */

const
  _libcrash =
    await import(
      'libcrash-js');
/* global
     _argv */
const
_argv =
  _libcrash._argv;
/* global
     _argv_url_get */
const
_argv_url_get =
  _libcrash._argv_url_get;
/* global
     _basename */
const
_basename =
  _libcrash._basename;
/* global
     _cmdline_check */
const
  _cmdline_check =
    _libcrash._cmdline_check;
/* global
     _echo */
const
  _echo =
    _libcrash._echo;
/* global
     _echo2 */
const
  _echo2 =
    _libcrash._echo2;
/* global
     _exit */
const
  _exit =
    _libcrash._exit;
/* global
     _get */
const
  _get =
    _libcrash._get;
/* global
     _global_get */
const
  _global_get =
    _libcrash._global_get;
/* global
     _msg_info */
const
  _msg_info =
    _libcrash._msg_info;
/* global
     _msg_error */
const
_msg_error =
  _libcrash._msg_error;
/* global
     _override_set */
const
  _override_set =
    _libcrash._override_set;
/* global
     _require */
const
_require =
  _libcrash._require;
/* global
     _set */
const
  _set =
    _libcrash._set;
/* global
     _yargv_get */
const
_yargv_get =
  _libcrash._yargv_get;
const
  _base64_module =
    await import(
      "./libbase64");
/* global
     _base64 */
const
  _base64 =
    _base64_module._base64;

function
  _global_variables() {
  /* global
       app_name:
         writable */
  _override_set(
    "app",
    "name",
    "tmcbase64");
  /* global
       app_opts:
         writable */
  _override_set(
    "app",
    "opts",
    []);
  /* global
       runtime_environment:
         writable */
  _override_set(
    "runtime",
    "environment",
    "");
  /* global
       encode_data:
         writable */
  _override_set(
    "encode",
    "data",
    "");
  /* global
       decode_data:
         writable */
  _override_set(
    "decode",
    "data",
    "");
  /* global
       chunks_amount:
         writable */
  _override_set(
    "chunks",
    "amount",
    "");
  // string_length =
  //   "";
  /* global
       size_max:
         writable */
  _override_set(
    "size",
    "max",
    "");
  /* global
       input_files:
         writable */
  _override_set(
    "input",
    "files",
    []);
  /* global
       output_prefix:
         writable */
  _override_set(
    "output",
    "prefix",
    "");
  /* global
       quiet:
         writable */
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    "";
  /* global
       verbose:
         writable */
  _global[
    "verbose"] =
    "";
}

function 
  _overrides_set() {
  const
    _input_file =
      _get(
        "input",
        "file");
  _override_set(
    "decode",
    "data",
    "n");
  const
    _decode_data =
      _get(
        "decode",
        "data");
  if ( _decode_data === "n" ) {
    _override_set(
      "encode",
      "data",
      "y");
  }
}

function
  _config_show() {
  let
    _line;
  const
    _text = [
      `${app_name} configuration:`,
      `      Runtime environment:   ${runtime_environment}`,
      `              Decode data:   ${decode_data}`,
      `              Encode data:   ${encode_data}`,
      `              Input files:`,
    ];
  for ( _file of input_files ) {
    _text.push(
      `                             ${_file}`);
  }
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line,
    _program;
  _program =
    _basename(
      _argv[
        0]);
  if ( _program === "node" ) {
    _program =
      _basename(
        _argv[
          1]);
  }
  const
    _text = [
      "",
      "Base64 encode or decode FILE, (not standard input), to standard output.",
      "Mandatory arguments to long options are mandatory for short options too.",
      "",
      "Usage:",
      "",
      "  base64",
      "    [option]",
      "    [FILE]",
      "",
      "  arguments:",
      "    <FILE>                         An input file.",
      "",
      "  options:",
      "",
      "     -d, --decode                  Decode data.",
      `                                   Default: '${decode_data}'`,
      "",
      "     -h --help                     This message.",
      "     -v --verbose                  Enable verbose output.",
      "",
    ];
  for ( _line of _text ) {
    _echo(
      _line);
  }
  _exit(
    _exit_code);
}

function
  _cmdline_parse_help(
    _argv) {
  const
    _help_display =
      _argv[
        "help"] ||
      _argv[
        "h"];
  if ( _help_display ) {
    quiet =
      "n";
    _usage(
      0);
  }
}

function
  _input_args_check(
    _argv) {
  if ( _argv[
         "_"].length < 1 ) {
    const
      _msg =
        "Input file argument required.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
}

async function 
  _cmdline_parse() {
  const
    _argv =
      await _yargv_get();
  quiet = 
    "y";
  _set(
    "runtime",
    "environment",
    "node");
  _cmdline_parse_help(
    _argv);
  _input_args_check(
    _argv);
  _set(
    "input",
    "file",
    _argv[
      "_"][
        0]);
  if ( _argv[
         "_"].length < 2 ) {
    _set(
      "output",
      "prefix",
      _get(
        "input",
        "file"));
  }
  if ( "a" in _argv ) {
    _set(
      "suffix",
      "length",
      _argv[
        "a"]);
  }
  if ( "suffix-length" in _argv ) {
    _set(
      "suffix",
      "length",
      _argv[
        "suffix-length"]);
  }
  if ( "suffix-length" in _argv ) {
    _set(
      "suffix",
      "length",
      _argv[
        "suffix-length"]);
  }
  if ( "d" in _argv ) {
    _set(
      "numeric",
      "suffix",
      true);
  }
  _set(
    "chunks",
    "amount",
    _argv[
      "chunks-amount"] ||
    _argv[
      "n"]);
  _set(
    "chunks",
    "amount",
    _argv[
      "size-max"] ||
    _argv[
      "b"]);
  const
    _global =
      _global_get();
  _global[
    "verbose"] =
    _argv[
      "verbose"] ||
    _argv[
      "v"];
  if ( _global[
         "verbose"] ) {
    _global[
      "quiet"] =
      "n";
  }
}

function
  _url_parse() {
  const
    _argv =
      _argv_url_get();
  runtime_environment =
    "browser";
  input_file =
    _argv[
      "input_file"][
        0];
  output_prefix =
    _argv_url_get[
      "output_prefix"][
        0];
  chunks_amount =
    _argv_url_get[
      "chunks_amount"][
        0];
  quiet =
    _argv_url_get[
      "quiet"];
  if ( quiet.length === 0 ) {
    quiet =
      "n";
  }
}

_global_variables();
_overrides_set();
if ( _cmdline_check(
       "tmcbase64") ||
     _cmdline_check(
       "base64") ||
     _cmdline_check(
       "base64.js") ) {
  await _cmdline_parse();
}
else {
  _url_parse();
}
_config_show();
const
  app_opts = [
    encode_data,
    decode_data,
    input_files,
  ];
try {
  _base64.apply(
    null,
    app_opts);
}
catch(
  _error) {
  const
    _msg =
      "Error running '_base64' " +
      "with arguments:";
  _msg_error(
    _msg,
    0);
  _echo2(
    app_opts);
  _echo2(
    _error);
  _exit(
    1);
}
